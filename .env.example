# CareerPilot AI Configuration

# Application Port
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Provider Configuration
# Leave blank to use zero-cost Deterministic Mock Provider out of the box!
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Storage Configuration (Optional - S3 / R2 compatible; local storage active by default)
STORAGE_BUCKET=careerpilot-resumes
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Feature Flags
LOCK_ATS_MISTAKES_2_AND_3=true
ENABLE_VOICE_INTERVIEW_STUB=false

