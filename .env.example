# CareerPilot AI Configuration

# Application Port
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Provider Configuration
# Leave blank to use zero-cost Deterministic Mock Provider out of the box!
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Database Configuration (Optional for PostgreSQL / Docker)
# Local development runs zero-config localStorage/mockDb fallback!
DATABASE_URL=postgresql://careerpilot:careerpilot123@localhost:5432/careerpilot_db?schema=public

# Redis Configuration (Optional)
REDIS_URL=redis://localhost:6379

# Storage Configuration (S3 / R2 compatible)
STORAGE_BUCKET=careerpilot-resumes
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# PostHog Analytics (Optional - console fallback active by default)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Feature Flags
LOCK_ATS_MISTAKES_2_AND_3=true
ENABLE_VOICE_INTERVIEW_STUB=false
