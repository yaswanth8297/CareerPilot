// CareerPilot AI — Prisma Schema (24 Models per PRD Specification)

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = []
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// 1. IDENTITY DOMAIN
model User {
  id             String          @id @default(uuid())
  email          String?         @unique
  phone          String?         @unique
  role           String          @default("student") // student, admin
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accounts       AuthAccount[]
  sessions       Session[]
  consentRecords ConsentRecord[]
  profile        Profile?
  resumes        Resume[]
  roadmaps       Roadmap[]
  savedJobs      SavedJob[]
  interviews     InterviewSession[]

  @@map("users")
}

model AuthAccount {
  id                String   @id @default(uuid())
  userId            String
  provider          String   // phone_otp, google, magic_link
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String?
  guestId      String?
  expires      DateTime
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model ConsentRecord {
  id                  String   @id @default(uuid())
  userId              String
  dataProcessing      Boolean  @default(true)
  whatsAppUpdates     Boolean  @default(false)
  modelTrainingOptIn  Boolean  @default(false)
  ipAddress           String?
  grantedAt           DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("consent_records")
}

// 2. PROFILE AND CHAT DOMAIN
model Profile {
  id           String   @id @default(uuid())
  userId       String?  @unique
  sessionId    String   @unique
  branch       String
  year         String   // 1, 2, 3, 4, passed_out
  skills       String[]
  careerGoal   String
  targetRole   String
  collegeName  String?
  location     String?
  resumeFileId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Message {
  id        String   @id @default(uuid())
  sessionId String
  sender    String   // bot, user, system
  text      String
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("messages")
}

// 3. RESUME DOMAIN
model Resume {
  id           String        @id @default(uuid())
  userId       String?
  sessionId    String
  fileUrl      String?
  extractedText String       @db.Text
  targetRole   String
  createdAt    DateTime      @default(now())
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scores       ResumeScore[]

  @@map("resumes")
}

model ResumeScore {
  id                  String   @id @default(uuid())
  resumeId            String
  totalScore          Int
  formattingScore     Int
  keywordMatchScore   Int
  quantifiedScore     Int
  completenessScore   Int
  clarityScore        Int
  verdict             String
  mistakesPayload     Json
  createdAt           DateTime @default(now())
  resume              Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("resume_scores")
}

// 4. ROADMAP DOMAIN
model RoadmapTemplate {
  id           String   @id @default(uuid())
  roleKey      String   @unique
  title        String
  phaseNames   String[]
  createdAt    DateTime @default(now())

  @@map("roadmap_templates")
}

model Roadmap {
  id        String        @id @default(uuid())
  userId    String?
  sessionId String
  roleKey   String
  progress  Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeks     RoadmapWeek[]

  @@map("roadmaps")
}

model RoadmapWeek {
  id          String        @id @default(uuid())
  roadmapId   String
  weekNumber  Int
  phase       String
  title       String
  description String
  topics      String[]
  resourceId  String?
  isLocked    Boolean       @default(false)
  roadmap     Roadmap       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  tasks       RoadmapTask[]

  @@map("roadmap_weeks")
}

model RoadmapTask {
  id          String      @id @default(uuid())
  weekId      String
  title       String
  completed   Boolean     @default(false)
  estMinutes  Int         @default(60)
  week        RoadmapWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@map("roadmap_tasks")
}

// 5. KNOWLEDGE DOMAIN
model CuratedResource {
  id         String   @id @default(uuid())
  title      String
  language   String   @default("en")
  difficulty String   @default("Beginner")
  url        String
  roleTags   String[]
  platform   String
  isFree     Boolean  @default(true)
  verifiedAt DateTime @default(now())

  @@map("curated_resources")
}

model RoleTemplate {
  id                  String   @id @default(uuid())
  roleKey             String   @unique
  title               String
  category            String
  primarySkills       String[]
  secondarySkills     String[]
  atsKeywords         String[]
  recommendedProjects String[]
  interviewTopics     String[]

  @@map("role_templates")
}

// 6. JOBS DOMAIN
model Job {
  id               String     @id @default(uuid())
  title            String
  company          String
  location         String
  isRemote         Boolean    @default(false)
  jobType          String     // Fresher, Internship
  salaryRange      String?
  applyUrl         String
  hasCgpaFilter    Boolean    @default(false)
  minCgpaRequired  Float?
  isScamSuspicious Boolean    @default(false)
  scamReasons      String[]
  createdAt        DateTime   @default(now())
  skills           JobSkill[]
  matches          JobMatch[]
  savedBy          SavedJob[]

  @@map("jobs")
}

model JobSkill {
  id     String @id @default(uuid())
  jobId  String
  skill  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_skills")
}

model JobMatch {
  id           String   @id @default(uuid())
  jobId        String
  sessionId    String
  matchPercent Int
  whyItMatches String
  createdAt    DateTime @default(now())
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_matches")
}

model SavedJob {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  savedAt   DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@map("saved_jobs")
}

// 7. INTERVIEW DOMAIN
model InterviewSession {
  id        String             @id @default(uuid())
  userId    String?
  sessionId String
  roleKey   String
  duration  Int                @default(300)
  createdAt DateTime           @default(now())
  user      User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers   InterviewAnswer[]
  feedback  FeedbackReport?

  @@map("interview_sessions")
}

model InterviewQuestion {
  id                String   @id @default(uuid())
  roleKey           String
  category          String   // Introduction, Technical, Project, HR/Behavioral
  questionHinglish  String
  questionEnglish   String
  expectedKeywords  String[]
  sampleIdealAnswer String   @db.Text

  @@map("interview_questions")
}

model InterviewAnswer {
  id               String           @id @default(uuid())
  sessionId        String
  questionId       String
  userAnswer       String           @db.Text
  timeSpentSeconds Int              @default(0)
  interviewSession InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("interview_answers")
}

model FeedbackReport {
  id               String           @id @default(uuid())
  sessionId        String           @unique
  overallScore     Float
  contentScore     Float
  clarityScore     Float
  confidenceScore  Float
  commScore        Float
  strengths        String[]
  improvements     String[]
  idealAnswer      String           @db.Text
  nextAction       String
  createdAt        DateTime         @default(now())
  interviewSession InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("feedback_reports")
}

// 8. PLATFORM DOMAIN
model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventName String
  sessionId String
  payload   Json?
  timestamp DateTime @default(now())

  @@map("analytics_events")
}
